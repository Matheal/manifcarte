---
import Base from "../layouts/Base.astro";
import { CAUSES } from "../lib/shared";
import { PERIOD_LABEL, SCOPE_LABEL } from "../scripts/filters";
import { loadDataset } from "../lib/data";

const data = loadDataset();
const focus = data.focus;
---

<Base fullscreen description={`Carte en direct des manifestations, blocus et rassemblements à ${focus.name}, en France et dans le monde.`}>
  <div class="map-app" data-focus={JSON.stringify(focus)}>
    <aside class="panel" aria-label="Mobilisations visibles sur la carte">
      <button class="sheet-handle" type="button" aria-expanded="false" aria-controls="panel-body">
        <span class="grip" aria-hidden="true"></span>
        <span class="summary" id="summary">Chargement des mobilisations…</span>
      </button>
      <div class="panel-body" id="panel-body">
        <div class="panel-head">
          <p class="updated muted small" id="updated"></p>
          <label class="visually-hidden" for="q">Rechercher une ville, un lycée…</label>
          <input id="q" type="search" placeholder="Rechercher une ville, un lycée…" autocomplete="off" />
          <div class="filter-row" role="group" aria-label="Période">
            {
              Object.entries(PERIOD_LABEL).map(([k, v]) => (
                <button class="chip" type="button" data-period={k} aria-pressed="false">
                  {v}
                </button>
              ))
            }
          </div>
          <div class="filter-row" role="group" aria-label="Zone">
            {
              Object.entries(SCOPE_LABEL).map(([k, v]) => (
                <button class="chip" type="button" data-scope={k} aria-pressed="false">
                  {v}
                </button>
              ))
            }
          </div>
          <details class="more-filters">
            <summary>Plus de filtres <span id="filter-count"></span></summary>
            <div class="filter-row" role="group" aria-label="Causes">
              {
                Object.entries(CAUSES).map(([k, v]) => (
                  <button class="chip" type="button" data-cause={k} aria-pressed="false">
                    {v}
                  </button>
                ))
              }
            </div>
            <label class="small muted" for="level">Fiabilité minimale</label>
            <select id="level">
              <option value="1">Toutes les mobilisations</option>
              <option value="2">Probables et confirmées</option>
              <option value="3">Confirmées seulement (3 sources ou plus)</option>
            </select>
          </details>
        </div>
        <p class="list-title small muted" id="list-title"></p>
        <div class="list" id="list" role="list"></div>
      </div>
    </aside>

    <div class="map-wrap">
      <div id="map" role="region" aria-label="Carte interactive des mobilisations"></div>
      <div class="views" role="group" aria-label="Recentrer la carte">
        <button class="btn" type="button" data-view="focus">{focus.name}</button>
        <button class="btn" type="button" data-view="france">France</button>
        <button class="btn" type="button" data-view="world">Monde</button>
      </div>
      <div class="legend" aria-hidden="true">
        <span><i class="today"></i>Aujourd'hui</span>
        <span><i class="upcoming"></i>À venir</span>
        <span><i class="past"></i>Passée</span>
        <span><i class="world"></i>Monde</span>
      </div>
      <p class="map-error" id="map-error" hidden></p>
    </div>
  </div>
</Base>

<script>
  import "../scripts/map";
</script>

<style>
  .map-app {
    display: grid;
    grid-template-columns: 400px 1fr;
    height: 100%;
  }
  .panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--bg);
    border-right: 1px solid var(--border);
    z-index: 2;
  }
  .sheet-handle {
    display: none;
  }
  .panel-body {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }
  .panel-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 16px 12px;
    border-bottom: 1px solid var(--border);
  }
  .updated {
    margin: 0;
  }
  .filter-row {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .filter-row::-webkit-scrollbar {
    display: none;
  }
  .more-filters summary {
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-2);
  }
  .more-filters[open] {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .more-filters[open] .filter-row {
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .list-title {
    margin: 12px 16px 0;
  }
  .list {
    flex: 1;
    overflow-y: auto;
    padding: 8px 16px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .map-wrap {
    position: relative;
    min-width: 0;
  }
  #map {
    position: absolute;
    inset: 0;
  }
  .views {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 6px;
    z-index: 1;
  }
  .views .btn {
    box-shadow: var(--shadow);
    height: 36px;
    padding: 0 14px;
  }
  .legend {
    position: absolute;
    left: 12px;
    bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    padding: 8px 12px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: var(--shadow);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-2);
    z-index: 1;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 15%);
  }
  .legend .today {
    background: var(--today);
  }
  .legend .upcoming {
    background: var(--upcoming);
  }
  .legend .past {
    background: var(--past);
  }
  .legend .world {
    background: var(--world);
  }
  .map-error {
    position: absolute;
    top: 60px;
    left: 12px;
    right: 12px;
    margin: 0;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
    z-index: 2;
  }

  @media (max-width: 860px) {
    .map-app {
      grid-template-columns: 1fr;
      position: relative;
    }
    .map-wrap {
      position: absolute;
      inset: 0;
    }
    .panel {
      position: absolute;
      z-index: 5;
      left: 0;
      right: 0;
      bottom: 0;
      max-height: 78%;
      border-right: 0;
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -6px 28px rgb(0 0 0 / 18%);
      background: var(--bg);
    }
    .sheet-handle {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 10px 16px 14px;
      border: 0;
      background: none;
      color: var(--text);
      font: inherit;
      font-weight: 650;
      cursor: pointer;
    }
    .summary {
      font-size: 0.92rem;
      text-align: center;
    }
    .grip {
      width: 40px;
      height: 5px;
      border-radius: 3px;
      background: var(--border);
    }
    .panel-body {
      display: none;
    }
    .panel.open .panel-body {
      display: flex;
      height: 62dvh;
    }
    .panel-head {
      padding-top: 0;
    }
    .legend {
      display: none;
    }
    .views {
      left: 8px;
      right: 8px;
      top: 8px;
    }
  }
</style>

<style is:global>
  /* Sur mobile, les contrôles du bas restent au-dessus du panneau coulissant. */
  @media (max-width: 860px) {
    .map-wrap .maplibregl-ctrl-bottom-right,
    .map-wrap .maplibregl-ctrl-bottom-left {
      bottom: 76px;
    }
  }
  /* Popups MapLibre */
  .maplibregl-popup-content {
    background: var(--surface) !important;
    color: var(--text);
    border-radius: 14px !important;
    padding: 14px 16px !important;
    box-shadow: var(--shadow) !important;
    font-family: var(--font);
    max-width: 300px;
  }
  .maplibregl-popup-tip {
    border-top-color: var(--surface) !important;
    border-bottom-color: var(--surface) !important;
  }
  .maplibregl-popup-close-button {
    font-size: 20px;
    color: var(--text-2);
    right: 6px !important;
    top: 4px !important;
  }
  .popup h3 {
    margin: 6px 0 4px;
    font-size: 1rem;
    padding-right: 14px;
  }
  .popup p {
    margin: 6px 0;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  .popup .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 0.82rem;
    color: var(--text-2);
  }
  .popup a.more {
    display: inline-block;
    margin-top: 6px;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }
  .list .event-card.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
</style>
